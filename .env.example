# Configuration du site DevLauncher. Copie ce fichier en « devlauncher.env » dans le dossier PARENT du site
# (ex. /home/moncompte/devlauncher.env si le site est dans /home/moncompte/public_html/devlauncher),
# ou en « .env » dans le dossier du site. Ne le publie jamais tel quel avec tes vraies clés.

# --- Général
APP_VERSION=1.5.0
INSTALLER=downloads/DevLauncher-Setup-1.5.0.exe
SITE_URL=https://novatechbenin.com/devlauncher
TIMEZONE=Africa/Porto-Novo

# --- Contact et e-mails (crée la boîte no-reply dans cPanel > Comptes de messagerie)
CONTACT_EMAIL=contact@novatechbenin.com
FROM_EMAIL=no-reply@novatechbenin.com
WHATSAPP_NUMBER=22966185595
COMMUNITY_URL=https://chat.whatsapp.com/Ea1u7p4KD5261ZBGuOzCrw

# --- Envoi des e-mails (avis, rapports) : serveur SMTP, bien plus fiable que la fonction mail() de PHP
# cPanel > Comptes de messagerie > crée no-reply@ton-domaine > « Configurer le client de messagerie » : serveur sortant et port.
# SMTP_SECURE=ssl avec le port 465, tls avec le port 587. Laisser SMTP_HOST vide pour utiliser mail() de PHP.
# Tests locaux avec DevLauncher : SMTP_HOST=127.0.0.1, SMTP_PORT=2525, SMTP_SECURE=none (les mails arrivent dans sa Boîte mail).
SMTP_HOST=mail.novatechbenin.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=no-reply@novatechbenin.com
SMTP_PASS=
SMTP_FROM_NAME=DevLauncher · Novatech Solution

# --- Installateur signé (passe à true quand le certificat de signature de code est utilisé)
INSTALLER_SIGNED=false
PUBLISHER=Novatech Solution

# --- Compteur public : vrai nombre, affiché à partir de ce seuil (0 = toujours ; avant le seuil : « Nouveau »)
COUNTER_MIN_DISPLAY=0

# --- Compte à rebours de lancement (laisser vide pour ne rien afficher)
# LAUNCH_AT=2026-12-01 10:00
# LAUNCH_LOCK=true bloque le téléchargement jusqu'à la date (sinon le compte à rebours est seulement informatif)
LAUNCH_AT=
LAUNCH_LOCK=false

# --- Rapport WhatsApp des téléchargements (cron/rapport.php)
# Choisis UN fournisseur :
#
# REPORT_PROVIDER=greenapi  (le plus simple, gratuit)
#   1. Crée un compte sur https://green-api.com puis une instance « Developer » (gratuite).
#   2. Relie ton WhatsApp en scannant le QR code (comme WhatsApp Web) : le rapport arrive dans ta discussion avec toi-même.
#   3. Recopie depuis la console : apiUrl -> GREENAPI_URL, idInstance -> GREENAPI_INSTANCE, apiTokenInstance -> GREENAPI_TOKEN.
#   (Service non officiel : idéalement, relie un numéro WhatsApp Business dédié plutôt que ton numéro personnel.)
#
# REPORT_PROVIDER=meta  (officiel, plus long à mettre en place)
#   Compte Meta Business + application « WhatsApp » sur https://developers.facebook.com : META_WA_TOKEN (jeton permanent
#   d'un utilisateur système), META_WA_PHONE_ID (identifiant du numéro). Meta n'autorise un message automatique quotidien
#   QUE via un modèle approuvé : crée un modèle « Utilitaire » nommé par ex. rapport_devlauncher, langue Français, avec ce texte :
#     Rapport DevLauncher : {{1}} téléchargements au total, {{2}} aujourd'hui, {{3}} sur 7 jours. Avis : {{4}}.
#   puis indique son nom dans META_WA_TEMPLATE.
#
# REPORT_PROVIDER=email : rapport par e-mail seulement.
# (REPORT_PROVIDER=callmebot reste disponible avec CALLMEBOT_APIKEY si le service fonctionne pour toi.)
REPORT_PROVIDER=greenapi
REPORT_PHONE=22966185595
GREENAPI_URL=https://api.green-api.com
GREENAPI_INSTANCE=
GREENAPI_TOKEN=
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=fr
CALLMEBOT_APIKEY=
REPORT_EMAIL_COPY=true
# Jeton secret pour un cron « par URL » (cron-job.org...) : https://.../cron/rapport.php?token=CE_JETON
# Génère une longue valeur aléatoire. Vide = rapport uniquement en ligne de commande (cron cPanel).
CRON_TOKEN=
